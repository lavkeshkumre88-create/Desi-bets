rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 60 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidSongRecord(data, songId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.songId is string &&
             data.songId == songId &&
             isValidId(data.songId) &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 200 &&
             data.artist is string &&
             data.artist.size() >= 1 &&
             data.artist.size() <= 200 &&
             data.language is string &&
             data.language.size() >= 1 &&
             data.language.size() <= 40 &&
             data.audioUrl is string &&
             data.audioUrl.size() >= 1 &&
             data.audioUrl.size() <= 1000 &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 1000)) &&
             (!('lrcUrl' in data) || (data.lrcUrl is string && data.lrcUrl.size() <= 1000)) &&
             data.sourceType is string &&
             data.sourceType in ['LOCAL_DEVICE', 'REMOTE_LICENSED'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidPlaylist(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 80 &&
             data.songCount is int &&
             data.songCount >= 0 &&
             data.songCount <= 500 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Favorites
      match /favorites/{songId} {
        allow get: if isOwner(userId) && isValidId(songId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(songId) &&
                         incoming().keys().hasAll(['userId', 'songId', 'title', 'artist', 'language', 'audioUrl', 'sourceType', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'songId', 'title', 'artist', 'language', 'audioUrl', 'coverUrl', 'lrcUrl', 'sourceType', 'createdAt']) &&
                         isValidSongRecord(incoming(), songId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(songId);
      }

      // User Playlists
      match /playlists/{playlistId} {
        allow get: if isOwner(userId) && isValidId(playlistId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         incoming().keys().hasAll(['userId', 'name', 'songCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'songCount', 'createdAt', 'updatedAt']) &&
                         isValidPlaylist(incoming());
        allow update: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         isValidPlaylist(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'songCount', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(playlistId);

        // Playlist Tracks
        match /tracks/{songId} {
          allow get: if isOwner(userId) && isValidId(playlistId) && isValidId(songId);
          allow list: if isOwner(userId) && isValidId(playlistId);
          allow create: if isOwner(userId) &&
                           isValidId(playlistId) &&
                           isValidId(songId) &&
                           exists(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId)) &&
                           incoming().keys().hasAll(['userId', 'songId', 'title', 'artist', 'language', 'audioUrl', 'sourceType', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'songId', 'title', 'artist', 'language', 'audioUrl', 'coverUrl', 'lrcUrl', 'sourceType', 'createdAt']) &&
                           isValidSongRecord(incoming(), songId);
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(playlistId) && isValidId(songId);
        }
      }
    }
  }
}
